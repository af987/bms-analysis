#!/bin/bash
# Restart Wi-Fi if the default gateway stops answering for 3 checks in a row. Run every minute by
# givcap-netcheck.timer. On the first real box the Pi's Wi-Fi went silent while still reporting
# "connected" after a mesh access point sent a roaming request.
STATE="${GIVCAP_NETCHECK_STATE:-/run/givcap-netcheck.fails}"
GW=$(ip -4 route | awk '/^default/ {print $3; exit}')
if [ -n "$GW" ] && ping -c 3 -W 2 "$GW" >/dev/null 2>&1; then
    echo 0 > "$STATE"
    exit 0
fi
n=$(( $(cat "$STATE" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$STATE"
logger -t givcap-netcheck "gateway ${GW:-none} unreachable ($n)"
if [ "$n" -ge 3 ]; then
    WIFI=$(nmcli -t -f NAME,TYPE con show --active | awk -F: '$2 == "802-11-wireless" {print $1; exit}')
    if [ -n "$WIFI" ]; then
        logger -t givcap-netcheck "restarting Wi-Fi connection $WIFI"
        nmcli con down "$WIFI"
        sleep 2
        nmcli con up "$WIFI"
    else
        logger -t givcap-netcheck "no active Wi-Fi connection; toggling the Wi-Fi radio"
        nmcli radio wifi off
        sleep 2
        nmcli radio wifi on
    fi
    echo 0 > "$STATE"
fi
